{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts/check-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "windows:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-windows.ps1",
    "windows:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-windows.ps1",
    "windows:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-windows.ps1"
  },
  "packageManager": "pnpm@10.26.1",
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
